@Metadata.layer: #CORE

@UI: {
  headerInfo: {
    typeName: 'Movimiento de Material',
    typeNamePlural: 'Movimientos de Material',
                      typeImageUrl: 'sap-icon://excel-attachment',

    title: { type: #STANDARD, value: 'DocumentoMaterial' },
    description: { type: #STANDARD, value: 'NombreMaterial' }
  }
}

annotate entity Z_I_MOVIMIENTO_MATERIAL with
{
  /* =========================================================
     CONFIGURACIÓN DE LA OBJECT PAGE (Pestañas y Grupos)
     ========================================================= */
  @UI.facet: [
    {
      id:              'GeneralCollection',
      type:            #COLLECTION,
      label:           'Información del Documento',
      position:        10
    },
    {
      id:              'GrupoLogistica',
      type:            #FIELDGROUP_REFERENCE,
      parentId:        'GeneralCollection',
      targetQualifier: 'LogisticaGroup',
      label:           'Datos de Logística',
      position:        10
    },
    {
      id:              'GrupoFinanzas',
      type:            #FIELDGROUP_REFERENCE,
      parentId:        'GeneralCollection',
      targetQualifier: 'FinanzasGroup',
      label:           'Datos Contables y Financieros',
      position:        20
    }
  ]

  /* =========================================================
     CABECERA Y CAMPOS PRINCIPALES DE BÚSQUEDA
     ========================================================= */
  @UI.selectionField: [{ position: 10 }]
  @UI.lineItem:       [{ position: 10 }]
  @UI.fieldGroup:     [{ qualifier: 'LogisticaGroup', position: 10 }]
  @UI.identification: [{ position: 10 }]
  @Consumption.filter:{ selectionType: #SINGLE, multipleSelections: true }
  DocumentoMaterial;

  @UI.lineItem:       [{ position: 20 }]
  @UI.selectionField: [{ position: 20 }]
  @UI.identification: [{ position: 20 }]
  @UI.fieldGroup:     [{ qualifier: 'LogisticaGroup', position: 20 }]
  AnioDocumento;

//  @UI.lineItem:       [{ position: 30 }]
//  @UI.identification: [{ position: 30 }]
  @UI.fieldGroup:     [{ qualifier: 'LogisticaGroup', position: 30 }]
  Posicion;

  @UI.selectionField: [{ position: 40 }]
  @UI.lineItem:       [{ position: 40 }]
  @UI.identification: [{ position: 40 }]
  @UI.fieldGroup:     [{ qualifier: 'LogisticaGroup', position: 40 }]
  @Search.defaultSearchElement: true
  CodigoMaterial;

  @UI.selectionField: [{ position: 45 }]
  @UI.lineItem:       [{ position: 50 }]
  @UI.identification: [{ position: 50 }]
  @UI.fieldGroup:     [{ qualifier: 'LogisticaGroup', position: 50 }]
  @Search.defaultSearchElement: true
  @Search.fuzzinessThreshold: 0.8
  NombreMaterial;


  /* =========================================================
     GRUPO DE LOGÍSTICA (LogisticaGroup)
     ========================================================= */
  @UI.selectionField: [{ position: 60 }]
  @UI.lineItem:       [{ position: 60 }]
  @UI.fieldGroup:     [{ qualifier: 'LogisticaGroup', position: 60 }]
  Centro;

  @UI.selectionField: [{ position: 70 }]
  @UI.lineItem:       [{ position: 70 }]
  @UI.fieldGroup:     [{ qualifier: 'LogisticaGroup', position: 70 }]
  ClaseMovimiento;

  @UI.selectionField: [{ position: 80 }]
  @UI.lineItem:       [{ position: 80 }]
  @UI.fieldGroup:     [{ qualifier: 'LogisticaGroup', position: 80 }]
  FechaContabilizacion;

  @UI.fieldGroup: [{ qualifier: 'LogisticaGroup', position: 90 }]
  StorageLocation;

  @UI.fieldGroup: [{ qualifier: 'LogisticaGroup', position: 100 }]
  StorageType;

  @UI.fieldGroup: [{ qualifier: 'LogisticaGroup', position: 110 }]
  StorageBin;

  @UI.fieldGroup: [{ qualifier: 'LogisticaGroup', position: 120 }]
