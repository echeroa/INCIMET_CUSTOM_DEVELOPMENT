  @EndUserText.label: 'Documento Contable'
  @Consumption.semanticObject: 'AccountingDocument' // Replicado del estándar: usamos AccountingDocument
  @Consumption.semanticObjectMapping.additionalBinding:[
    { localElement: 'CompanyCode',      element: 'CompanyCode' },
    { localElement: 'FiscalYear', element: 'FiscalYear' },
    { localElement: 'AsientoContable',  element: 'AccountingDocument' } // Mapea tu campo Z al campo estándar
  ]
  @UI: {
    lineItem:       [{ position: 90 }], // Posición normal en la tabla, Fiori Elements lo hará azul automáticamente
    identification: [{ position: 90 }],
    fieldGroup:     [{ qualifier: 'FinanzasGroup', position: 10 }]
  }

